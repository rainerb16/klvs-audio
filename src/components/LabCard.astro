---
import type { CollectionEntry } from "astro:content";
import { STAGES } from "../config";

interface Props { item: CollectionEntry<"lab"> }
const { name, type, formats, status, blurb, badge } = Astro.props.item.data;
const stages = STAGES[type] as readonly string[];
const now = stages.indexOf(status);
const kind = type === "plugin" ? `Plugin · ${formats}` : formats;
---
<article class="card" data-tilt data-reveal>
  <header>
    <div>
      <span class="kind">{kind}</span>
      <h3>{name}</h3>
    </div>
    <span class="badge">{badge}</span>
  </header>
  <p class="muted">{blurb}</p>
  <ol class="stages" style={`--n: ${stages.length}`} aria-label="Progress">
    {stages.map((s, i) => (
      <li class={i < now ? "done" : i === now ? "now" : undefined} aria-current={i === now ? "step" : undefined}>{s}</li>
    ))}
  </ol>
</article>

<style>
  .card { background: var(--rack); border: 1px solid var(--line); border-radius: 8px; padding: clamp(22px, 3vw, 36px); display: grid; gap: 20px; align-content: start; min-width: 0; }
  header { display: flex; justify-content: space-between; align-items: start; gap: 16px; flex-wrap: wrap; }
  header > div { display: grid; gap: 8px; }
  .kind { font-family: var(--mono); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--silver); }
  .stages { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 6px; }
  .stages li { display: grid; gap: 8px; font-family: var(--mono); font-size: .62rem; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); min-width: 0; }
  @media (max-width: 420px) { .stages li { font-size: .54rem; letter-spacing: 0; } }
  .stages li::before { content: ""; height: 3px; border-radius: 2px; background: var(--line); }
  .stages li.done { color: var(--silver); }
  .stages li.done::before { background: var(--silver); }
  .stages li.now { color: var(--fg); }
  .stages li.now::before { background: var(--red); box-shadow: 0 0 8px var(--red); }
</style>
