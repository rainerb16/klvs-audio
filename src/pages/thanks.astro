---
import Base from "../layouts/Base.astro";
---
<Base title="You're on the list" noindex>
  <section class="band">
    <div class="wrap thanks">
      <span class="eyebrow">Waitlist</span>
      <h1>You're on the list.</h1>
      <p class="lede">Thanks for signing up. I'll email you when the free Max for Live device is ready, and when a plugin is close to release.</p>
      <div class="cta-row"><a class="btn btn-ghost" href="/">Back to the site</a></div>
    </div>
  </section>
</Base>

<style>
  .thanks { display: grid; gap: 22px; max-width: 720px; min-height: 50vh; align-content: center; }
</style>
