---
import Base from "../../layouts/Base.astro";
import NoteList from "../../components/NoteList.astro";
import WaitlistForm from "../../components/WaitlistForm.astro";
import { listNotes } from "../../notes";

const notes = await listNotes();
---
<Base title="Lab notes" description="Short posts about building the WRM1 plugin, the Arrangr Max for Live device and whatever comes next.">
  <section class="band">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Lab notes</span>
        <h1>Lab notes</h1>
        <p class="muted">Short posts about building WRM1, Arrangr and whatever comes next. Some DSP, some mixing, some Max for Live.</p>
      </div>
      <NoteList notes={notes} />
    </div>
  </section>
  <WaitlistForm />
</Base>
